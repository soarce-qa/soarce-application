{% extends "layout.twig" %}

{% set activeMainMenu = "coverage" %}


{%  block head %}
    <title>SOARCE</title>
{%  endblock %}

{%  block header %}
    Coverage Analysis
{% endblock %}

{% block main %}


    <p>See below a list of files in which at least one line was executed. Click on a link to open the detail view of the code.
        The list can be filtered with the following controls:</p>

    {% embed "filterbox.twig" %}
        {% block action %}/coverage/files{% endblock %}
        {% block filters %}
        {% import 'controls.twig' as controls %}
        <div class="form-group">
            <label for="">Application:</label>
            {{ controls.select('applicationId', applicationIds, applications) }}
        </div>
        <div class="form-group">
            <label for="">Usecases:</label>
            {{ controls.select('usecaseId',     usecaseIds,     usecases) }}
        </div>
        <div class="form-group">
            <label for="">Requests:</label>
            {{ controls.select('requestId',     requestIds,     requests) }}
        </div>
        {% endblock %}

        {% block buttons %}
        <div class="btn-group">
            <a href="/coverage" class="btn btn-default"><i class="fa fa-angle-left"></i> back</a>
            <button type="submit" value="update" name="whatever" class="btn btn-primary"><i class="fa fa-sync"></i> update</button>
        </div>
        {% endblock %}
    {% endembed %}

<div class="row">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">Files</h3>
            </div>
            <div class="card-body">
                <table id="filesTable" class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>application</th>
                            <th>file</th>
                            <th>lines</th>
                            <th>total lines covered</th>
                            <th style="width: 160px">---</th>
                            <th>total %</th>
                            <th>filtered lines covered</th>
                            <th style="width: 160px">---</th>
                            <th>filtered %</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr>
                            <th>application</th>
                            <th>file</th>
                            <th>lines</th>
                            <th>total lines covered</th>
                            <th>---</th>
                            <th>total %</th>
                            <th>filtered lines covered</th>
                            <th>---</th>
                            <th>filtered %</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>


{% endblock %}

{% block pageEnd %}
    <script>
        function coverageColor(percentage) {
            if (percentage < 50) {
                return 'red';
            } else if (percentage < 75) {
                return 'yellow';
            } else {
                return 'green';
            }
        }

        $(function () {
            $('#filesTable').DataTable({
                'serverSide'  : true,
                'ajax'        : {
                    url: '/coverage/filesAjax?{{ queryString|raw }}',
                    type: 'POST'
                },
                'paging'      : true,
                'pageLength'  : 25,
                'lengthChange': true,
                "lengthMenu": [ 10, 25, 50, 100, 250 ],
                'searching'   : true,
                'ordering'    : true,
                'info'        : true,
                'autoWidth'   : true,
                order: [[ 1, 'asc' ]],
                columnDefs: [
                    {
                        render: function (data, type, row) {
                            return '<a href="' + row.url + '">' + data + '</a>';
                        },
                        targets: 1
                    },{
                        render: function (data, type, row) {
                            return '<div class="progress progress-xs"><div class="progress-bar progress-bar-' + coverageColor(data) + '" style="width: ' + data + '%"></div></div>';
                        },
                        targets: [4, 7]
                    },{
                        render: function (data, type, row) {
                            return '<span class="badge bg-' + coverageColor(data) + '">' + data + '%</span>';
                        },
                        targets: [5, 8]
                    }
                ],
                columns: [
                    { data: 'application', name: 'application', searchable: false, orderable: false },
                    { data: 'file', name: 'file', searchable: true, orderable: true },
                    { data: 'lines', name: 'lines', searchable: false, orderable: true, type: 'num', className: 'text-right' },
                    { data: 'totalCoveredLines', name: 'totalCoveredLines', searchable: false, orderable: true, type: 'num', className: 'text-right' },
                    { data: 'totalPercentageBar', name: 'totalPercentageBar', searchable: false, orderable: false },
                    { data: 'totalPercentageNumber', name: 'totalPercentageNumber', searchable: false, orderable: true, type: 'num', className: 'text-center' },
                    { data: 'filteredCoveredLines', name: 'filteredCoveredLines', searchable: false, orderable: false, type: 'num', className: 'text-right' },
                    { data: 'filteredPercentageBar', name: 'filteredPercentageBar', searchable: false, orderable: false },
                    { data: 'filteredPercentageNumber', name: 'filteredPercentageNumber', searchable: false, orderable: false, type: 'num', className: 'text-center' }
                ]
            });

            $('.select2').select2();
        })
    </script>
{% endblock %}
